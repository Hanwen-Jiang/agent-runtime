# 叠在 Firecracker 的 guest 配置（kernel.conf 的 FC_CONFIG_NAME）之上；build-kernel.sh 构建后逐项核对还在
# （kconfig 遇到依赖不满足会悄悄丢掉一项）。只写与基础配置不同、或者我们依赖它不能变的项。

# 不要模块：没有 initramfs，rootfs 只读，模块无处可装；也少一类能在运行时加载的内核代码。
# CONFIG_MODULES is not set

# 串口控制台：firecracker 把 ttyS0 写到标准输出，fc-manager 收进这台 VM 的日志（console=ttyS0）。
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# 设备只有 virtio-mmio 的块设备与 vsock。没有网卡的驱动（D-22：联网只经 vsock 到出网网关）；
# 不要 vsock 的本机回环，客户机里的进程连不到 agent 自己的端口。
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# CONFIG_VSOCKETS_LOOPBACK is not set
# CONFIG_VIRTIO_NET is not set

# 只读的 ext4 rootfs，可写的放在 scratch 盘上（overlay 的上层）；/dev 由内核挂（agent 当 PID 1，没有 udev）。
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# agent 在客户机里给命令设上限、过滤系统调用。
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y

# 快照恢复后让客户机知道自己被克隆过（D-26 要用）。
CONFIG_VMGENID=y

# uname -r 带上后缀，一眼看得出是这里构建的内核。
CONFIG_LOCALVERSION="-agentruntime"
# CONFIG_LOCALVERSION_AUTO is not set
