# fc-manager 的配置（deploy/cluster/fc-manager.service 的 EnvironmentFile）。install.sh 在 /etc/agentruntime/fc-manager.env
# 不存在时拷这一份（0600）；没写的取 services/rs-fc-manager/src/config.rs 里的默认值。这里不放任何密钥。

# 只听 k3s 的 cni0（单节点集群的 Pod 网关地址，k3s 默认的 cluster-cidr 10.42.0.0/16；装好后用 ip -4 addr show cni0 核对）。
# 公网网卡上 ar-firewall 只放 22；Pod 到这个地址的流量不出宿主，所以不做 TLS，靠令牌认证（docs/plan/firecracker-backend.md 第 10 节）。
AR_FC_LISTEN=10.42.0.1:8097

# SecretStore 文件（格式同开发 SecretStore），平台作用域里要有 sandbox/fc-manager-token（至少 32 个字符）；0600，属主 root。
AR_SECRETS_FILE=/etc/agentruntime/fc-manager-secrets.json

# 宿主上的目录。jail、内核与 rootfs 要在同一个文件系统上（内核与 rootfs 硬链接进 jail，不拷）。
AR_FC_STATE_DIR=/var/lib/agentruntime/fc/state
AR_FC_CHROOT_BASE=/var/lib/agentruntime/fc/jail
AR_FC_IMAGES_DIR=/var/lib/agentruntime/fc/images
AR_FC_KERNEL=/var/lib/agentruntime/fc/images/vmlinux

# install.sh 装的 Firecracker（versions.conf 的 FIRECRACKER_VERSION）。
AR_FC_JAILER_BIN=/usr/local/bin/jailer
AR_FC_FIRECRACKER_BIN=/usr/local/bin/firecracker
AR_FC_IP_BIN=/usr/sbin/ip
AR_FC_MKFS_BIN=/usr/sbin/mkfs.ext4

# 每台 VM 一个 uid：AR_FC_UID_BASE 起、AR_FC_MAX_VMS 个，不要与宿主上已有的用户或容器的 uid 重叠。
AR_FC_UID_BASE=900000

# 宿主容量（24 线程、125 GB 的独服）：超过时建环境返回 503 host_capacity（transient），已有的 VM 不受影响。
AR_FC_MAX_VMS=16
AR_FC_MAX_VCPUS=32
AR_FC_MAX_MEMORY_MIB=65536
AR_FC_MAX_SCRATCH_MIB=262144

# 客户机出网（D-22，services/rs-fc-manager/src/net.rs）：客户机里 127.0.0.1:3128、3129 的转发经 vsock 到这里，再转给出网网关
# 与包镜像。写 IP:端口（宿主上解析不了集群里的域名）：kubectl -n agent-runtime get svc 里两个 Service 的 ClusterIP。
# Service 重建后 ClusterIP 会变，要跟着改并重启 fc-manager（先排空，见 fc-manager.service 的说明）。没写的不开。
# AR_FC_EGRESS_TARGET=10.43.x.x:8095
# AR_FC_MIRROR_TARGET=10.43.x.x:8093
