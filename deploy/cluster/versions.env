# 集群与第三方组件的版本（docs/plan/cloud-deploy.md D-02、D-03）。install.sh 与 deploy/data/install.sh 读这里，不用 latest。
# 这些是写计划时（2026-10）已发布满两周的稳定版；装之前到各项目的发布页核对一次，升级时改这里并在提交信息里写明。
K3S_VERSION=v1.33.4+k3s1
# gVisor 按日期发布（https://gvisor.dev/docs/user_guide/install/）；install.sh 下载这个版本的 runsc 与 containerd-shim-runsc-v1 并核对 sha512。
GVISOR_RELEASE=20250825
KATA_VERSION=3.20.0
CERT_MANAGER_VERSION=v1.18.2
KEDA_VERSION=2.17.2
CNPG_CHART_VERSION=0.26.0
CNPG_BARMAN_PLUGIN_VERSION=v0.6.0
TEMPORAL_CHART_VERSION=0.66.0
QDRANT_CHART_VERSION=1.15.4
REDPANDA_CHART_VERSION=25.1.1
LANGFUSE_CHART_VERSION=1.4.1
