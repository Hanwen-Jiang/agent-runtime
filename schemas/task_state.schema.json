{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentruntime.example/schemas/task_state.schema.json",
  "title": "Task State",
  "description": "Task 的结构化状态（附录 A、B.1）：目标、约束、里程碑、已验证事实、待查假设、Round 记录、产物与固定的版本。它是 Task 工作流的状态，通过查询读取；租户由工作流输入的 TenantContext 确定，不写在这里。",
  "type": "object",
  "required": ["task_id", "session_id", "goal", "done_when"],
  "properties": {
    "task_id": {"$ref": "defs.schema.json#/$defs/task_id"},
    "session_id": {"$ref": "defs.schema.json#/$defs/session_id"},
    "goal": {"$ref": "defs.schema.json#/$defs/non_empty_string"},
    "done_when": {"$ref": "defs.schema.json#/$defs/non_empty_string"},
    "done_when_code": {"description": "done_when 是代码给的默认说明时的代码（例如 answer_question）；调用方给的 done_when 没有这一项。只在查询 Task State 时带，不进工作流里的 Task State，模型看不到（TMP 计划第 11.5 节）", "$ref": "defs.schema.json#/$defs/message_code"},
    "status": {"$ref": "defs.schema.json#/$defs/task_status"},
    "constraints": {
      "description": "通用约束有固定字段；其余是领域约束，例如 quarter，节点用 $task.constraints.<名> 引用",
      "type": "object",
      "properties": {
        "effect_ceiling": {"$ref": "defs.schema.json#/$defs/effect"},
        "budget_usd": {"$ref": "defs.schema.json#/$defs/usd"},
        "wall_clock_min": {"description": "时间预算（分钟，租户策略的 budget.wall_clock_min）：只算 Agent 在跑的时间，等人回复的时间不算；用完时问人，人选择继续就再加一份（TMP 计划第 3 节）", "type": "number", "minimum": 0},
        "tool_calls": {"description": "工具调用次数的上限（租户策略的 budget.tool_calls）：用完时问人，人选择继续就再加一份（TMP 计划第 3 节）", "type": "integer", "minimum": 0},
        "deadline_min": {"type": "number", "minimum": 0}
      }
    },
    "budget_used": {
      "description": "时间与工具调用预算的用量（TMP 计划第 3 节）；美元的用量是各 Round 的 cost_usd 之和",
      "type": "object",
      "properties": {
        "wall_clock_min": {"description": "Task 开始以来 Agent 在跑的时间（分钟，工作流时间），不算等人回复的时间", "type": "number", "minimum": 0},
        "tool_calls": {"description": "已经发出的工具调用：tool_loop 里的每次调用，含 sub_agent、子图等子工作流里的（program 节点在 activity 里调的工具不数）", "type": "integer", "minimum": 0},
        "extensions": {"description": "时间或工具调用预算用完后，人选择继续、加了几份", "type": "integer", "minimum": 0}
      },
      "unevaluatedProperties": false
    },
    "milestones": {"description": "粗计划，可随时调整", "type": "array", "items": {"$ref": "defs.schema.json#/$defs/non_empty_string"}},
    "facts": {"description": "已验证的事实", "type": "array", "items": {"$ref": "defs.schema.json#/$defs/non_empty_string"}},
    "assumptions": {"description": "待回查的假设", "type": "array", "items": {"$ref": "defs.schema.json#/$defs/non_empty_string"}},
    "open_questions": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/non_empty_string"}},
    "rounds": {"type": "array", "items": {"$ref": "#/$defs/round"}},
    "guidance": {"description": "用户在运行中发来的纠偏（docs/plan/running-task-interaction.md 第 2 节），按发出的顺序。Planner 与 Reviewer 都看得到，Reviewer 据此验收。撤回的不在这里，模型看不到", "type": "array", "items": {"$ref": "#/$defs/guidance"}},
    "artifacts": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/object_uri"}},
    "plan": {
      "description": "当前的 Task Plan 步骤（N-04，人工验收基线 Q55）：Task 工作流是唯一写者，Planner 每轮给出的步骤通过检查后替换它，结束时正在做的一步记为 done（done）或 blocked（其余结局）。每次变了都推 plan_updated（同样的内容）。fast 与之前的运行没有",
      "type": "object",
      "required": ["steps", "round_seq"],
      "properties": {
        "steps": {"$ref": "defs.schema.json#/$defs/plan_steps"},
        "round_seq": {"description": "定下这份步骤的 Round", "type": "integer", "minimum": 1},
        "current_step": {"description": "正在做的一步（status 为 active 的那步）；没有时不写", "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64}
      },
      "unevaluatedProperties": false
    },
    "pinned": {
      "description": "Task 启动时固定的版本，运行中不受新发布影响（设计书 3.1.2）",
      "type": "object",
      "properties": {
        "recipe": {"anyOf": [{"$ref": "defs.schema.json#/$defs/recipe_ref"}, {"type": "null"}]},
        "node_templates": {"type": "object", "additionalProperties": {"$ref": "defs.schema.json#/$defs/version"}},
        "reasoning_templates": {"type": "object", "additionalProperties": {"$ref": "defs.schema.json#/$defs/version"}},
        "model_profiles": {"type": "object", "additionalProperties": {"$ref": "defs.schema.json#/$defs/non_empty_string"}}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "guidance": {
      "type": "object",
      "required": ["guidance_id", "text", "mode", "state"],
      "properties": {
        "guidance_id": {"$ref": "defs.schema.json#/$defs/guidance_id"},
        "text": {"$ref": "defs.schema.json#/$defs/non_empty_string"},
        "mode": {"$ref": "defs.schema.json#/$defs/guidance_mode"},
        "state": {"$ref": "defs.schema.json#/$defs/guidance_state"},
        "applied_round": {"description": "在哪个 Round 生效；state 为 applied 时才有", "type": "integer", "minimum": 1}
      },
      "if": {"required": ["state"], "properties": {"state": {"const": "applied"}}},
      "then": {"required": ["applied_round"]},
      "else": {"properties": {"applied_round": {"$ref": "defs.schema.json#/$defs/forbidden"}}},
      "unevaluatedProperties": false
    },
    "round_highlights": {
      "description": "这一轮的重要输出，给人看的汇总（docs/plan/running-task-interaction.md 第 4 节）：不给 Planner 与 Reviewer",
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"$ref": "defs.schema.json#/$defs/non_empty_string"},
              "why": {"description": "为什么重要，一句话；代码补上的改动文件可以没有", "type": "string", "maxLength": 300}, "delivered": {"description": "这一轮经 deliver_file 交付给了用户（N-18，docs/plan/n18-file-delivery-f3.md）：排在最前面，客户端可以给下载入口；没交付的文件不写", "type": "boolean"}
            },
            "unevaluatedProperties": false
          }
        },
        "answers": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
      },
      "unevaluatedProperties": false
    },
    "round": {
      "type": "object",
      "required": ["seq", "stage_goal"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "stage_goal": {"$ref": "defs.schema.json#/$defs/non_empty_string"},
        "triage_level": {"$ref": "defs.schema.json#/$defs/triage_level"},
        "status": {"$ref": "defs.schema.json#/$defs/round_status"},
        "verdict": {"$ref": "defs.schema.json#/$defs/verdict"},
        "cost_usd": {"$ref": "defs.schema.json#/$defs/usd"},
        "tool_calls": {"description": "这个 Round 发出的工具调用次数（TMP 计划第 3 节）", "type": "integer", "minimum": 0},
        "highlights": {"$ref": "#/$defs/round_highlights"}
      },
      "allOf": [
        {
          "description": "没结束的 Round 没有 Verdict",
          "if": {"required": ["status"], "properties": {"status": {"not": {"const": "completed"}}}},
          "then": {"properties": {"verdict": {"$ref": "defs.schema.json#/$defs/forbidden"}}}
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
