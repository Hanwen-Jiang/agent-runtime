{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentruntime.example/schemas/atomic_node.schema.json",
  "title": "Atomic Node",
  "description": "从 Node Template 实例化、执行一次的节点（附录 A、D.1）。规则：executor 决定 output、tier、reasoning 能否出现（D.1、E.3）；effect 决定缓存、重试与幂等键（D.4）；role = act 时必须是写操作（D.5）。幂等键由代码按 tenant_id、task_id、node_id 与输入哈希生成后填入，不由模型编写。",
  "type": "object",
  "required": ["id", "kind", "template", "executor", "effect", "role"],
  "properties": {
    "id": {"$ref": "defs.schema.json#/$defs/node_id"},
    "kind": {"const": "atomic"},
    "template": {"$ref": "defs.schema.json#/$defs/template_ref"},
    "executor": {"$ref": "defs.schema.json#/$defs/executor"},
    "output": {"$ref": "defs.schema.json#/$defs/model_output"},
    "effect": {"$ref": "defs.schema.json#/$defs/effect"},
    "role": {"$ref": "defs.schema.json#/$defs/role"},
    "after": {"$ref": "defs.schema.json#/$defs/after"},
    "inputs": {"$ref": "defs.schema.json#/$defs/inputs"},
    "output_schema": {"$ref": "defs.schema.json#/$defs/output_schema"},
    "budget": {
      "type": "object",
      "properties": {
        "timeout_s": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"$ref": "defs.schema.json#/$defs/usd"}
      },
      "unevaluatedProperties": false
    },
    "retry": {
      "type": "object",
      "required": ["max"],
      "properties": {
        "max": {"type": "integer", "minimum": 0, "maximum": 10},
        "on": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/retry_on"}, "uniqueItems": true},
        "backoff": {"$ref": "defs.schema.json#/$defs/backoff"}
      },
      "unevaluatedProperties": false
    },
    "cache": {
      "description": "缓存键 = 模板版本 + 输入哈希（附录 D.1）",
      "type": "object",
      "properties": {
        "ttl_s": {"type": "integer", "minimum": 1}
      },
      "unevaluatedProperties": false
    },
    "idempotency_key": {"type": ["string", "null"], "minLength": 1},
    "fallback": {"$ref": "defs.schema.json#/$defs/fallback"},
    "tier": {"$ref": "defs.schema.json#/$defs/tier"},
    "reasoning": {"$ref": "defs.schema.json#/$defs/reasoning"},
    "quality": {"$ref": "defs.schema.json#/$defs/quality_spec"}
  },
  "allOf": [
    {
      "description": "model 节点必须给出 output；其他执行者不带 output、tier、reasoning",
      "if": {"required": ["executor"], "properties": {"executor": {"const": "model"}}},
      "then": {"required": ["output"]},
      "else": {"properties": {"output": {"$ref": "defs.schema.json#/$defs/forbidden"}, "tier": {"$ref": "defs.schema.json#/$defs/forbidden"}, "reasoning": {"$ref": "defs.schema.json#/$defs/forbidden"}}}
    },
    {
      "description": "reasoning 只用于生成型 model 节点（附录 E.3）",
      "if": {"required": ["output"], "properties": {"output": {"const": "generate"}}},
      "else": {"properties": {"reasoning": {"$ref": "defs.schema.json#/$defs/forbidden"}}}
    },
    {
      "description": "写操作必须带幂等键，且不缓存（附录 D.4）",
      "if": {"required": ["effect"], "properties": {"effect": {"$ref": "defs.schema.json#/$defs/write_effect"}}},
      "then": {
        "required": ["idempotency_key"],
        "properties": {"idempotency_key": {"type": "string"}, "cache": {"$ref": "defs.schema.json#/$defs/forbidden"}}
      }
    },
    {
      "description": "write_irreversible 不自动重试（附录 D.4）",
      "if": {"required": ["effect"], "properties": {"effect": {"const": "write_irreversible"}}},
      "then": {"properties": {"retry": {"properties": {"max": {"const": 0}}}}}
    },
    {
      "description": "effect = read 的缓存必须设 TTL（附录 D.4）",
      "if": {"required": ["effect", "cache"], "properties": {"effect": {"const": "read"}}},
      "then": {"properties": {"cache": {"required": ["ttl_s"]}}}
    },
    {
      "description": "role = act 时 effect 必须是写操作（附录 D.5）",
      "if": {"required": ["role"], "properties": {"role": {"const": "act"}}},
      "then": {"properties": {"effect": {"$ref": "defs.schema.json#/$defs/write_effect"}}}
    }
  ],
  "unevaluatedProperties": false
}
