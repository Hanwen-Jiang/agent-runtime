{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentruntime.example/schemas/task_event_payload.schema.json",
  "title": "TaskEvent 的载荷：进度事件",
  "description": "Task 工作流经 publish_task_event 推送、客户端经 SSE 收到的进度事件的载荷（taskapi.v1.TaskEvent.payload；设计书 4.14，T-11b）。event 与 SSE 的事件名相同。只描述 Round、Stage、Node、tool_loop 里每次工具调用的进度、Task Plan 的步骤、决策调用的重试与等待中的问题，不带 Node 的结果、工具的输出与 rationale：结果只在 task_finished 里（Task 的结局）。task_accepted 没有载荷，task_finished 的载荷是 TaskWorkflowResult，都不在这里。",
  "type": "object",
  "required": ["event"],
  "properties": {
    "event": {"$ref": "defs.schema.json#/$defs/progress_event"}
  },
  "allOf": [
    {"if": {"required": ["event"], "properties": {"event": {"const": "round_started"}}}, "then": {"$ref": "#/$defs/round_started"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "stage_started"}}}, "then": {"$ref": "#/$defs/stage_started"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "node_started"}}}, "then": {"$ref": "#/$defs/node_started"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "node_finished"}}}, "then": {"$ref": "#/$defs/node_finished"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "tool_status"}}}, "then": {"$ref": "#/$defs/tool_status"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "human_input_required"}}}, "then": {"$ref": "#/$defs/human_input_required"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "verdict"}}}, "then": {"$ref": "#/$defs/verdict"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "decision_retry"}}}, "then": {"$ref": "#/$defs/decision_retry"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "guidance_updated"}}}, "then": {"$ref": "#/$defs/guidance_updated"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "task_message_edited"}}}, "then": {"$ref": "#/$defs/task_message_edited"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "context_usage"}}}, "then": {"$ref": "#/$defs/context_usage"}},
    {"if": {"required": ["event"], "properties": {"event": {"const": "plan_updated"}}}, "then": {"$ref": "#/$defs/plan_updated"}}
  ],
  "$defs": {
    "round_seq": {"description": "Round 序号，从 1 开始", "type": "integer", "minimum": 1},
    "round_started": {
      "description": "一个 Round 开始：规划之前（rerun 为 true 时不经 Planner，重跑上一个 Stage 里出问题的部分）",
      "type": "object",
      "required": ["event", "round_seq", "rerun"],
      "properties": {
        "event": {"const": "round_started"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "rerun": {"type": "boolean"}
      },
      "unevaluatedProperties": false
    },
    "stage_started": {
      "description": "这个 Round 的 Stage 定了：目标、退出条件与节点清单（只有 id、kind、role）",
      "type": "object",
      "required": ["event", "round_seq", "goal", "exit_when", "nodes"],
      "properties": {
        "event": {"const": "stage_started"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "triage_level": {"description": "Planner 的分诊级别；重跑时不经 Planner，没有这一项", "$ref": "defs.schema.json#/$defs/triage_level"},
        "goal": {"type": "string"},
        "goal_code": {"description": "goal 是代码生成的固定说明时的代码（例如 fast 规划的 reply_to_message）；Planner 写的 goal 没有这一项（TMP 计划第 5 节）", "$ref": "defs.schema.json#/$defs/message_code"},
        "exit_when": {"type": "string"},
        "exit_when_code": {"description": "exit_when 是代码生成的固定说明时的代码（例如 fast 规划的 reply_given）；Planner 写的 exit_when 没有这一项（TMP 计划第 11.5 节）", "$ref": "defs.schema.json#/$defs/message_code"},
        "params": {"description": "goal_code、exit_when_code 的参数（例如 run_recipe 的 recipe、node_result 的 node）", "$ref": "defs.schema.json#/$defs/message_params"},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": {"$ref": "defs.schema.json#/$defs/node_id"},
              "kind": {"$ref": "defs.schema.json#/$defs/node_kind"},
              "role": {"$ref": "defs.schema.json#/$defs/role"}
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "node_started": {
      "description": "Stage 的一个顶层 Node 开始执行（上游都成功了、调度到它）；因上游没成功而跳过的不报。客户端据此显示正在做什么",
      "type": "object",
      "required": ["event", "round_seq", "node_id", "kind"],
      "properties": {
        "event": {"const": "node_started"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "node_id": {"$ref": "defs.schema.json#/$defs/node_id"},
        "kind": {"$ref": "defs.schema.json#/$defs/node_kind"},
        "role": {"$ref": "defs.schema.json#/$defs/role"},
        "executor": {"$ref": "defs.schema.json#/$defs/executor"},
        "mode": {"description": "Goal Node 的展开方式（N-16）：sub_agent 时客户端把它画成一个子 Agent，之后 node_id 为它的 tool_status、context_usage 是这个子 Agent 的进度；Atomic Node 没有", "$ref": "defs.schema.json#/$defs/mode"},
        "result": {"$ref": "defs.schema.json#/$defs/forbidden"},
        "rationale": {"$ref": "defs.schema.json#/$defs/forbidden"}
      },
      "unevaluatedProperties": false
    },
    "tool_status": {
      "description": "顶层 Goal Node 的 tool_loop 里一次工具调用的状态（附录 E.1）：调用前 running，调用后 succeeded 或 failed。顶层的 sub_agent 在自己的子工作流里调用的也推（N-16），node_id 是那个 sub_agent Goal Node，并行的几个子 Agent 的事件交错到达、按 event_id 排；sub_task、子图等其余子工作流里的调用不推。target 是给人看的简短说明（repo_* 的路径、shell_run 命令的开头），经凭据脱敏；不带工具的输出",
      "type": "object",
      "required": ["event", "round_seq", "node_id", "step", "tool", "state"],
      "properties": {
        "event": {"const": "tool_status"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "node_id": {"description": "这次调用所在的 Goal Node（sub_agent 里的调用是那个 sub_agent Goal Node）", "$ref": "defs.schema.json#/$defs/node_id"},
        "step": {"description": "tool_loop 的第几步，从 1 开始", "type": "integer", "minimum": 1},
        "tool": {"type": "string", "minLength": 1, "maxLength": 128},
        "state": {"$ref": "defs.schema.json#/$defs/tool_call_state"},
        "target": {"description": "这次调用作用在什么上：路径、命令的开头、网址；经凭据脱敏，截到 160 个字符", "type": "string", "maxLength": 160},
        "duration_ms": {"description": "succeeded、failed 时这次调用花了多久（工作流时间）", "type": "integer", "minimum": 0},
        "sandbox_startup_ms": {"description": "这次调用新建了沙箱环境时，借到环境花的时间（冷启动）；复用已有环境时没有这一项", "type": "integer", "minimum": 0},
        "error": {"description": "failed 时的说明，截到 300 个字符", "type": "string", "maxLength": 300},
        "error_code": {"description": "failed 时工具错误的代码（例如 file_not_found）；客户端按它翻译，error 作后备（TMP 计划第 5 节）", "$ref": "defs.schema.json#/$defs/message_code"},
        "output": {"description": "工具的输出不进进度事件", "$ref": "defs.schema.json#/$defs/forbidden"},
        "rationale": {"description": "rationale 只进 trace", "$ref": "defs.schema.json#/$defs/forbidden"}
      },
      "unevaluatedProperties": false
    },
    "node_finished": {
      "description": "Stage 的一个顶层 Node 结束（包括因上游没成功而跳过的）。不带结果与 rationale",
      "type": "object",
      "required": ["event", "round_seq", "node_id", "role", "status"],
      "properties": {
        "event": {"const": "node_finished"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "node_id": {"$ref": "defs.schema.json#/$defs/node_id"},
        "role": {"$ref": "defs.schema.json#/$defs/role"},
        "status": {"description": "结束时的状态（附录 D.6、K.4）", "$ref": "defs.schema.json#/$defs/finished_node_status"},
        "failure_class": {"$ref": "defs.schema.json#/$defs/failure_class"},
        "error": {"description": "失败说明，截到 300 个字符", "type": "string", "maxLength": 300},
        "error_code": {"description": "失败说明的代码（例如 budget_exhausted、tool_loop 的 max_iterations）；客户端按它翻译，error 作后备（TMP 计划第 5 节）", "$ref": "defs.schema.json#/$defs/message_code"},
        "params": {"description": "error_code 的参数", "$ref": "defs.schema.json#/$defs/message_params"},
        "result": {"description": "结果不进进度事件", "$ref": "defs.schema.json#/$defs/forbidden"},
        "rationale": {"description": "rationale 只进 trace", "$ref": "defs.schema.json#/$defs/forbidden"}
      },
      "unevaluatedProperties": false
    },
    "human_input_required": {
      "description": "问题已经发出、正在等人工回复。客户端用 question_id 与 options 之一经 SignalTask 回复",
      "type": "object",
      "required": ["event", "round_seq", "question_id", "kind", "text", "options", "deadline"],
      "properties": {
        "event": {"const": "human_input_required"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "question_id": {"description": "SignalTask 的 HumanReply.question_id：human 节点的 id、审批的 <id>.1、tool_loop 里一次调用的审批 <调用 id>.1、Reviewer 升级的 _review，或时间、工具调用预算用完时的 _budget（TMP 计划第 3 节）", "type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"$ref": "defs.schema.json#/$defs/question_kind"},
        "text": {"type": "string", "minLength": 1},
        "question_code": {"description": "text 是代码生成的问题时的代码（例如 budget_exhausted、rule_stuck）；客户端按它与 params 翻译，text 作后备。Planner、Reviewer 模型写的问题没有这一项（TMP 计划第 5 节）", "$ref": "defs.schema.json#/$defs/message_code"},
        "params": {"description": "question_code 的参数", "$ref": "defs.schema.json#/$defs/message_params"},
        "options": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "deadline": {"description": "等到什么时候（UTC），过了按超时处理", "type": "string", "format": "date-time"}
      },
      "unevaluatedProperties": false
    },
    "verdict": {
      "description": "Reviewer 对这个 Round 的判定（附录 B.4）",
      "type": "object",
      "required": ["event", "round_seq", "verdict", "reason"],
      "properties": {
        "event": {"const": "verdict"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "verdict": {"$ref": "defs.schema.json#/$defs/verdict"},
        "reason": {"type": "string"},
        "reason_code": {"description": "理由是代码给出或改写的时候的代码（规则的升级、预算用完、问人没有回复……）；模型自己写的理由没有这一项。客户端按它与 params 翻译，reason 作后备（TMP 计划第 5 节）", "$ref": "defs.schema.json#/$defs/message_code"},
        "params": {"description": "reason_code 的参数", "$ref": "defs.schema.json#/$defs/message_params"}
      },
      "unevaluatedProperties": false
    },
    "guidance_updated": {
      "description": "一条纠偏的状态变了（docs/plan/running-task-interaction.md 第 2 节）：pending 待生效（收到、改过，或者打断要等不可逆的调用结束），applied 已生效，retracted 已撤回，rejected 被拒绝。不带纠偏的文字",
      "type": "object",
      "required": ["event", "guidance_id", "state"],
      "properties": {
        "event": {"const": "guidance_updated"},
        "guidance_id": {"$ref": "defs.schema.json#/$defs/guidance_id"},
        "state": {"$ref": "defs.schema.json#/$defs/guidance_event_state"},
        "mode": {"description": "撤回或修改一条不存在的纠偏时没有", "$ref": "defs.schema.json#/$defs/guidance_mode"},
        "round_seq": {"description": "state 为 applied 时，在哪个 Round 生效", "$ref": "#/$defs/round_seq"},
        "reason_code": {"description": "rejected 的原因（task_finished、already_applied、not_found、too_many_pending），或 pending 的说明（irreversible_in_flight：这一步不可撤销，完成后立刻生效）", "$ref": "defs.schema.json#/$defs/message_code"}
      },
      "allOf": [
        {"if": {"required": ["state"], "properties": {"state": {"const": "applied"}}}, "then": {"required": ["round_seq"]}},
        {"if": {"required": ["state"], "properties": {"state": {"const": "rejected"}}}, "then": {"required": ["reason_code"]}}
      ],
      "unevaluatedProperties": false
    },
    "task_message_edited": {
      "description": "排队中的 Task 的消息改好了（applied），或者 Task 已经开始、没有改（rejected）。不带消息的文字：客户端重新查 Task",
      "type": "object",
      "required": ["event", "state"],
      "properties": {
        "event": {"const": "task_message_edited"},
        "state": {"$ref": "defs.schema.json#/$defs/queued_edit_state"},
        "reason_code": {"$ref": "defs.schema.json#/$defs/message_code"}
      },
      "if": {"required": ["state"], "properties": {"state": {"const": "rejected"}}},
      "then": {"required": ["reason_code"]},
      "unevaluatedProperties": false
    },
    "context_usage": {
      "description": "一次模型调用的上下文里各类内容占多少（docs/plan/running-task-interaction.md 第 3 节）：每次模型调用之后一条，token 是估算。只有数字与类别名，没有内容",
      "type": "object",
      "required": ["event", "round_seq", "node_id", "window_tokens", "effective_tokens", "total_tokens", "categories"],
      "properties": {
        "event": {"const": "context_usage"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "node_id": {"$ref": "defs.schema.json#/$defs/node_id"},
        "step": {"description": "tool_loop 的第几步；fast 的 answer 这样的模型节点没有", "type": "integer", "minimum": 1},
        "window_tokens": {"description": "模型的真实窗口（Model Profile 的 context_window）；取不到时等于 effective_tokens", "type": "integer", "minimum": 1},
        "effective_tokens": {"description": "Runtime 的压缩线：Context Builder 按它算阈值", "type": "integer", "minimum": 1},
        "total_tokens": {"description": "各类之和；Free space 由客户端用窗口减它", "type": "integer", "minimum": 0},
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "tokens"],
            "properties": {
              "name": {"$ref": "defs.schema.json#/$defs/context_category"},
              "tokens": {"type": "integer", "minimum": 0}
            },
            "unevaluatedProperties": false
          }
        },
        "tools": {
          "description": "每个工具的定义占多少，名字来自工具登记；界面默认只看合计",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "tokens"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "tokens": {"type": "integer", "minimum": 0},
              "mcp": {"type": "boolean"}
            },
            "unevaluatedProperties": false
          }
        },
        "applied": {"description": "这次用到的压缩步骤，按阶梯的顺序", "type": "array", "items": {"$ref": "defs.schema.json#/$defs/context_step"}}
      },
      "unevaluatedProperties": false
    },
    "plan_updated": {
      "description": "Task Plan 的步骤变了（N-04，人工验收基线 Q55、Q56）：带完整的步骤快照（同 Task State 的 plan），客户端丢掉旧的、按它重建计划区；不是增量。由 Task 工作流推送，是可重放的事件；fast 不推。同一 Round 结束时的最后一份另用去重键",
      "type": "object",
      "required": ["event", "round_seq", "steps"],
      "properties": {
        "event": {"const": "plan_updated"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "steps": {"$ref": "defs.schema.json#/$defs/plan_steps"},
        "current_step": {"description": "正在做的一步（status 为 active 的那步）；没有时不写", "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64}
      },
      "unevaluatedProperties": false
    },
    "decision_retry": {
      "description": "要等模型的决策 activity 的第 2 次及以后的尝试开始了（TMP 计划第 4 节）：哪一步、第几次、上次为什么没成。由 activity 自己推，不改工作流的命令序列；同一 Round 同一步的同一次尝试只推一次",
      "type": "object",
      "required": ["event", "round_seq", "step", "attempt", "max_attempts"],
      "properties": {
        "event": {"const": "decision_retry"},
        "round_seq": {"$ref": "#/$defs/round_seq"},
        "step": {"$ref": "defs.schema.json#/$defs/decision_step"},
        "node_id": {"description": "step 为 tool_loop_step 时，这一步所在的 Goal Node", "$ref": "defs.schema.json#/$defs/node_id"},
        "attempt": {"description": "这是第几次尝试，从 2 开始", "type": "integer", "minimum": 2},
        "max_attempts": {"description": "最多尝试几次（重试策略的上限）", "type": "integer", "minimum": 2},
        "error_code": {"description": "上一次尝试的错误代码（例如 grpc_deadline_exceeded、models_exhausted）；取不到时没有这一项", "$ref": "defs.schema.json#/$defs/message_code"},
        "error": {"description": "上一次尝试的错误说明，经凭据脱敏，截到 300 个字符", "type": "string", "maxLength": 300}
      },
      "allOf": [
        {
          "if": {"required": ["step"], "properties": {"step": {"const": "tool_loop_step"}}},
          "then": {"required": ["node_id"]},
          "else": {"properties": {"node_id": {"$ref": "defs.schema.json#/$defs/forbidden"}}}
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
